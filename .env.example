# SMTP settings for the contact form (defaults target Gmail).
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional: sender address (defaults to SMTP_USER)
# SMTP_FROM=your-address@gmail.com
# Optional: where form submissions are delivered (defaults to sumitpaul.work@gmail.com)
# OWNER_EMAIL=sumitpaul.work@gmail.com
